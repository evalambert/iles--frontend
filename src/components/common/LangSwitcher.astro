---
// src/components/common/LangSwitcher.astro

const pathname = Astro.url.pathname;
const [, currentLang, ...rest] = pathname.split('/');
const supported = ['fr', 'en'];
const safeLang = supported.includes(currentLang) ? currentLang : 'fr';
const otherLang = safeLang === 'fr' ? 'en' : 'fr';
const restPath = rest.length ? `/${rest.join('/')}` : '';
const otherUrl = `/${otherLang}${restPath}`;
---

<nav aria-label='Language switcher'>
    <a
        href={otherUrl}
        data-astro-transition
        class='text-title block min-w-[2ch] text-center'
        aria-label={`Switch language to ${otherLang.toUpperCase()}`}
    >
        {otherLang.toUpperCase()}
    </a>
</nav>
