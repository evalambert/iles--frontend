---
//layouts/Layout.astro
import '../assets/styles/global.css';
import Header from './Header.astro';
import { COVER_ANIMATION_DAY_KEY } from '../assets/scripts/libs/coverAnimationDaily';
import {
    DEFAULT_LOCALE,
    DEFAULT_OG_IMAGE,
    SITE_NAME,
    formatPageTitle,
    getAlternatePaths,
    toAbsoluteUrl,
} from '../config/seo';

interface Props {
    lang?: string;
    news?: unknown[];
    title?: string;
    description?: string;
    ogImage?: string;
    noindex?: boolean;
}

const {
    lang = Astro.params.lang ?? DEFAULT_LOCALE,
    news = [],
    title = SITE_NAME,
    description,
    ogImage = DEFAULT_OG_IMAGE,
    noindex = false,
} = Astro.props as Props;

const site = Astro.site ?? Astro.url;
const pageTitle = formatPageTitle(title);
const metaDescription = description ?? '';
const canonicalUrl = toAbsoluteUrl(site, Astro.url.pathname);
const ogImageUrl = toAbsoluteUrl(site, ogImage);
const ogLocale = lang === 'en' ? 'en_GB' : 'fr_FR';
const ogLocaleAlternate = lang === 'en' ? 'fr_FR' : 'en_GB';
const alternatePaths = getAlternatePaths(Astro.url.pathname);
const xDefaultPath =
    alternatePaths.find((a) => a.lang === DEFAULT_LOCALE)?.path ?? `/${DEFAULT_LOCALE}/`;

const organizationJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE_NAME,
    url: toAbsoluteUrl(site, `/${DEFAULT_LOCALE}/`),
};
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset='UTF-8' />
        <meta name='viewport' content='width=device-width, initial-scale=1' />
        <title>{pageTitle}</title>
        {metaDescription ? <meta name='description' content={metaDescription} /> : null}
        <link rel='canonical' href={canonicalUrl} />
        {noindex ? <meta name='robots' content='noindex, nofollow' /> : null}

        {
            alternatePaths.map(({ lang: alternateLang, path }) => (
                <link
                    rel='alternate'
                    hreflang={alternateLang}
                    href={toAbsoluteUrl(site, path)}
                />
            ))
        }
        <link rel='alternate' hreflang='x-default' href={toAbsoluteUrl(site, xDefaultPath)} />

        <meta property='og:type' content='website' />
        <meta property='og:site_name' content={SITE_NAME} />
        <meta property='og:title' content={pageTitle} />
        {metaDescription ? <meta property='og:description' content={metaDescription} /> : null}
        <meta property='og:url' content={canonicalUrl} />
        <meta property='og:image' content={ogImageUrl} />
        <meta property='og:locale' content={ogLocale} />
        <meta property='og:locale:alternate' content={ogLocaleAlternate} />

        <meta name='twitter:card' content='summary_large_image' />
        <meta name='twitter:title' content={pageTitle} />
        {metaDescription ? <meta name='twitter:description' content={metaDescription} /> : null}
        <meta name='twitter:image' content={ogImageUrl} />

        <link rel='icon' type='image/png' href='/png/favicon.png' />
        <meta name='astro-view-transitions' content='true' />

        <script type='application/ld+json' set:html={JSON.stringify(organizationJsonLd)} />

        {/* Avant hydrate des îlots : aligner le header avec “cover déjà passée” aujourd’hui */}
        <script is:inline define:vars={{ COVER_ANIMATION_DAY_KEY }}>
            (function () {
                try {
                    var t = new Date();
                    var today =
                        t.getFullYear() +
                        '-' +
                        String(t.getMonth() + 1).padStart(2, '0') +
                        '-' +
                        String(t.getDate()).padStart(2, '0');
                    window.__coverAnimationHidden =
                        localStorage.getItem(COVER_ANIMATION_DAY_KEY) === today;
                } catch (e) {
                    window.__coverAnimationHidden = false;
                }
            })();
        </script>
    </head>
    <body class='font-inter text-base bg-light'>
        <Header lang={lang} news={news} />
        <main>
            <slot />
        </main>
    </body>
</html>
