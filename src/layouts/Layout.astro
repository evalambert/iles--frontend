---
//layouts/Layout.astro
import '../assets/styles/global.css';
import Header from './Header.astro';
import { COVER_ANIMATION_DAY_KEY } from '../assets/scripts/libs/coverAnimationDaily';
import { NEWS_STICKY_SKIP_SESSION_KEY } from '../assets/scripts/libs/newsStickyEntry';

const { lang = Astro.params.lang ?? 'fr', news = [] } = Astro.props;
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset='UTF-8' />
        <meta name='viewport' content='width=device-width' />
        <title>Les Îles mardi</title>
        <link rel='icon' type='image/png' href='/png/favicon.png' />
        <meta name='astro-view-transitions' content='true' />
        {/* Avant hydrate des îlots : aligner le header avec “cover déjà passée” aujourd’hui */}
        <script is:inline define:vars={{ COVER_ANIMATION_DAY_KEY, NEWS_STICKY_SKIP_SESSION_KEY }}>
            (function () {
                try {
                    var t = new Date();
                    var today =
                        t.getFullYear() +
                        '-' +
                        String(t.getMonth() + 1).padStart(2, '0') +
                        '-' +
                        String(t.getDate()).padStart(2, '0');
                    window.__coverAnimationHidden =
                        localStorage.getItem(COVER_ANIMATION_DAY_KEY) === today;
                } catch (e) {
                    window.__coverAnimationHidden = false;
                }

                try {
                    var path = window.location.pathname || '/';
                    var isIndex =
                        path === '/' ||
                        /^\/(fr|en)\/?$/.test(path);
                    if (!isIndex) {
                        window.__newsStickySkipEntry = undefined;
                        return;
                    }

                    var ref = document.referrer || '';
                    var internal = false;
                    if (ref) {
                        try {
                            internal =
                                new URL(ref).origin === window.location.origin;
                        } catch (err) {
                            internal = false;
                        }
                    }

                    var skippedSession =
                        sessionStorage.getItem(NEWS_STICKY_SKIP_SESSION_KEY) ===
                        '1';
                    var skip = internal || skippedSession;
                    window.__newsStickySkipEntry = skip;
                    if (skip) {
                        sessionStorage.setItem(
                            NEWS_STICKY_SKIP_SESSION_KEY,
                            '1'
                        );
                    }
                } catch (e) {
                    window.__newsStickySkipEntry = false;
                }
            })();
        </script>
    </head>
    <body class='font-inter text-base bg-light'>
        <Header lang={lang} news={news} />
        <main>
            <slot />
        </main>
    </body>
</html>
