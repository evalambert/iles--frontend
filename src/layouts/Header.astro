---
import LangSwitcher from "../components/common/LangSwitcher.astro";

const { lang } = Astro.params;
---

<header class="h-header-height border-b fixed top-0 left-0 w-full bg-white z-10">
    <div class="grid grid-cols-6 h-full">
        <div
            class="col-span-3 lg:col-span-1 h-full bg-linear-to-t from-primary from-10% to-white to-70%"
        >
            <a
                href="/"
                rel=""
                class="font-semibold h-full w-full flex items-center justify-center"
            >
                Les Îles mardi
            </a>
        </div>

        <div
            class="col-span-3 lg:col-span-4 flex border-l bg-linear-to-t from-white from-10% to-primary to-70% lg:-ml-px"
        >
            <h2
                class="font-semibold text-center h-full w-full flex items-center justify-center"
            >
                {lang === "fr" ? "Entête actualités" : "Header news"}
            </h2>

            <div class="block lg:hidden border-l h-full items-center p-[10px]">
                <button class="w-full h-full flex items-center justify-center">
                    <svg
                        width="25"
                        height="27"
                        viewBox="0 0 25 27"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            d="M0.146447 3.32842C-0.0488155 3.52369 -0.0488155 3.84027 0.146447 4.03553L3.32843 7.21751C3.52369 7.41277 3.84027 7.41277 4.03553 7.21751C4.2308 7.02225 4.2308 6.70567 4.03553 6.5104L1.20711 3.68198L4.03553 0.853549C4.2308 0.658287 4.2308 0.341705 4.03553 0.146442C3.84027 -0.0488198 3.52369 -0.0488198 3.32843 0.146442L0.146447 3.32842ZM0.5 3.68198L0.5 4.18198L24.5 4.18198V3.68198V3.18198L0.5 3.18198L0.5 3.68198Z"
                            fill="#2F2F2E"></path>
                        <line
                            x1="24"
                            y1="3.68198"
                            x2="24"
                            y2="26.682"
                            stroke="#2F2F2E"></line>
                    </svg>
                </button>
            </div>
        </div>

        <div
            class="hidden lg:flex lg:col-span-1 border-l bg-linear-to-t from-primary to-white to-40% items-center"
        >
            <nav class="flex-1 h-full flex items-center">
                <a
                    href="/archive"
                    class="h-full w-full flex items-center justify-center text-title"
                    >Archive</a
                >
            </nav>
            <div class="flex border-l h-full items-center p-[15px]">
                <LangSwitcher />
            </div>

        </div>
    </div>
</header>
