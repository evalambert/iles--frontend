---
import LangSwitcher from '../components/common/LangSwitcher.astro';
import MobileMenuBtn from "../components/features/navigation/MobileMenuBtn.jsx";
import HeaderAnimation from "../components/features/animation/HeaderAnimation.jsx";
import NewsPreview from '../components/features/news/NewsPreview.jsx';
const { lang = 'fr', news = [] } = Astro.props;
// const { lang } = Astro.params;
const isEventPage =
    Astro.url.pathname.endsWith('/events') ||
    Astro.url.pathname.endsWith('/evenements') ||
    Astro.url.pathname.endsWith('/event') ||
    Astro.url.pathname.endsWith('/evenement') ||
    Astro.url.pathname.endsWith('/archive');
const eventPath = lang === 'en' ? `/${lang}/events` : `/${lang}/evenements`;
const navHref = isEventPage ? `/${lang}` : eventPath;

const navLabel = isEventPage
    ? lang === "en"
        ? "Home"
        : "Accueil"
    :  lang === "en" ? "Events" : "Événements";
---

<header
    class="h-header-height border-b fixed top-0 left-0 w-full bg-light z-50"
>
    <div class="grid grid-cols-6 h-full">
        <div
            class="col-span-3 lg:col-span-1 h-full bg-linear-to-t from-primary from-10% to-light to-70%"
        >
            <a
                href="/"
                rel=""
                class="font-semibold h-full w-full flex items-center justify-center"
            >
                <HeaderAnimation />
            </a>
        </div>

        <div
            class="col-span-3 lg:col-span-4 flex border-l bg-linear-to-t from-light from-10% to-primary to-70% lg:-ml-px"
        >

            <div class='h-full w-full'>
                <NewsPreview client:load news={news} />
            </div>

            <div class="block lg:hidden border-l h-full items-center p-[10px]">
                <MobileMenuBtn client:load />
            </div>
        </div>

        <div
            class="hidden lg:flex lg:col-span-1 border-l bg-linear-to-t from-primary to-light to-40% items-center"
        >
            <nav class="flex-1 h-full flex items-center">
                <a
                    href={navHref}
                    class="h-full w-full flex items-center justify-center text-title"
                    >{navLabel}</a
                >
            </nav>
            <div class="flex border-l h-full items-center p-[15px]">
                <LangSwitcher />
            </div>
        </div>
    </div>
</header>
