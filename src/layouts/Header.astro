---
import LangSwitcher from '../components/common/LangSwitcher.astro';

const { lang } = Astro.params;
---

<header
    class='border-2 border-pink-500 text-pink-500 p-4 flex items-center justify-between'
>
    <h1 class='font-semibold'>{lang === 'fr' ? 'Entête' : 'Header'}</h1>
    <LangSwitcher />
</header>
