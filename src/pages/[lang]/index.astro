---
//src/pages/[lang]/index.astro
import fetchApi from '../../assets/scripts/libs/strapi.js';
import Layout from '../../layouts/Layout.astro';
import WrapperIndex from '../../layouts/WrapperIndex.jsx';

const about = await fetchApi({
    endpoint: 'about?populate[Sections][populate]=*',
    wrappedByKey: 'data',
});

const members = await fetchApi({
    endpoint: 'members?populate=*',
    wrappedByKey: 'data',
});
---

<Layout>
    <WrapperIndex about={about} members={members} />
</Layout>
