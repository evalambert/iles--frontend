---
//src/pages/[lang]/index.astro
import fetchApi from '../../assets/scripts/libs/strapi.js';
import Layout from '../../layouts/Layout.astro';
import WrapperIndex from '../../layouts/WrapperIndex.jsx';

const { lang } = Astro.params;

const about = await fetchApi({
    endpoint: 'about',
    query: { populate: '*' },
    locale: lang,
    wrappedByKey: 'data',
});
---

<Layout>
    <WrapperIndex />
    <h1>{about?.Sections?.[0]?.Title ?? 'Aucun contenu'}</h1>
</Layout>
