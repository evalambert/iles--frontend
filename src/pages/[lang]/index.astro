---
//src/pages/[lang]/index.astro
import fetchApi from '../../assets/scripts/libs/strapi.js';
import Layout from '../../layouts/Layout.astro';
import WrapperIndex from '../../layouts/WrapperIndex.jsx';
import CoverAnimation from '../../components/features/animation/CoverAnimation.jsx';

const { lang } = Astro.params;

const fetchAllMembers = async (locale) => {
    const pageSize = 100;
    let page = 1;
    let pageCount = 1;
    const allMembers = [];

    while (page <= pageCount) {
        const membersResponse = await fetchApi({
            endpoint: 'members',
            query: {
                populate: '*',
                'pagination[page]': String(page),
                'pagination[pageSize]': String(pageSize),
            },
            locale,
        });

        const pageMembers = membersResponse?.data ?? [];
        allMembers.push(...pageMembers);
        pageCount = membersResponse?.meta?.pagination?.pageCount ?? 1;
        page += 1;
    }

    return allMembers;
};

const about = await fetchApi({
    endpoint: 'about',
    query: { 'populate[Sections][populate]': '*' },
    locale: lang,
    wrappedByKey: 'data',
});

const members = await fetchAllMembers(lang);

let news = [];
try {
    news = await fetchApi({
        endpoint: 'news',
        query: { populate: '*' },
        locale: lang,
        wrappedByKey: 'data',
    });
} catch (error) {
    news = [];
}
---

<Layout lang={lang} news={news}>
    <CoverAnimation client:load />
    <WrapperIndex
        client:load
        about={about}
        members={members}
        news={news}
        lang={lang}
    />
</Layout>
