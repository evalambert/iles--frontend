---
//src/pages/[lang]/index.astro
import fetchApi from '../../assets/scripts/libs/strapi.js';
import Layout from '../../layouts/Layout.astro';
import WrapperIndex from '../../layouts/WrapperIndex.jsx';
import CoverAnimation from '../../components/features/animation/CoverAnimation.jsx';

const { lang } = Astro.params;

const about = await fetchApi({
    endpoint: 'about',
    query: { 'populate[Sections][populate]': '*' },
    locale: lang,
    wrappedByKey: 'data',
});

const members = await fetchApi({
    endpoint: 'members',
    query: { populate: '*' },
    locale: lang,
    wrappedByKey: 'data',
});


let news = [];
try {
    news = await fetchApi({
        endpoint: 'news',
        query: { populate: '*' },
        locale: lang,
        wrappedByKey: 'data',
    });
} catch (error) {
    news = [];
}
---


<Layout lang={lang} news={news}>
    <CoverAnimation client:load />
    <WrapperIndex client:load about={about} members={members} news={news} lang={lang} />
</Layout>
