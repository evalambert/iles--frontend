---
//src/pages/[lang]/index.astro
import fetchApi from '../../assets/scripts/libs/strapi.js';
import Layout from '../../layouts/Layout.astro';
import WrapperIndex from '../../layouts/WrapperIndex.jsx';

const articles = await fetchApi({
    endpoint: 'about',
    query: {
        populate: '*',
        'pagination[page]': '1',
        'pagination[pageSize]': '6',
    },
    wrappedByKey: 'data',
});
---

<Layout>
    <WrapperIndex />
    <h1>Articles</h1>
    <pre>{JSON.stringify(articles, null, 2)}</pre>
</Layout>
