---
import fetchApi from '../../assets/scripts/libs/strapi.js';
import Layout from '../../layouts/Layout.astro';
import WrapperArchive from '../../layouts/WrapperArchive.jsx';
const { lang } = Astro.params;

if (lang !== 'fr') {
    return Astro.redirect(`/${lang ?? 'en'}/events`, 301);
}

const news = await fetchApi({
    endpoint: 'news',
    query: {
        'populate[Paragraphs][populate]': '*',
        'populate[Images][populate]': '*',
        'populate[event_categories][populate]': '*',
        'populate[Links][populate]': '*',
        'populate[RendezVous][populate]': '*',
    },
    locale: lang,
    wrappedByKey: 'data',
});
---

<Layout>
    <WrapperArchive client:load news={news} lang={lang} />
</Layout>
