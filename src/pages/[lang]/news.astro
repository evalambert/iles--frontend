---
import { fetchAllPaginated } from '../../assets/scripts/libs/strapi.js';
import Layout from '../../layouts/Layout.astro';
import WrapperArchive from '../../layouts/WrapperArchive.jsx';

const { lang } = Astro.params;

const newsQuery = {
    'populate[Paragraphs][populate]': '*',
    'populate[Images][populate]': '*',
    'populate[event_categories][populate]': '*',
    'populate[Links][populate]': '*',
    'populate[RendezVous][populate]': '*',
};

const news = await fetchAllPaginated({
    endpoint: 'news',
    query: newsQuery,
    locale: lang,
});
---

<Layout>
    <WrapperArchive client:load news={news} lang={lang} />
</Layout>
